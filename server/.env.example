# Sao chép file này thành .env rồi chỉnh theo máy của bạn
PORT=5000
CLIENT_URL=http://localhost:5173

# MySQL/MariaDB của XAMPP (mặc định: root, không mật khẩu)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=study_garden

# Dùng từ Đợt 2 (đăng nhập JWT) - đổi thành chuỗi ngẫu nhiên dài
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
